# העתיקי ל-.env.local ומלאי מ-Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Meta Lead Ads — client app id (OAuth dialog); server prefers META_APP_ID when set
VITE_META_APP_ID=

# כתובת קבועה ל-webhook (forms.app) — חייב להיות production, לא preview
# VITE_WEBHOOK_BASE_URL=https://smb-app-gray.vercel.app
# SUPABASE_SERVICE_ROLE_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v21.0
# META_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/integrations/meta/oauth/callback
# Server-only AES key for Meta/integration tokens (new writes — Phase 3A+)
# INTEGRATION_ENCRYPTION_KEY=

{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/forms/:connectionId",
      "destination": "/api/webhooks/forms?connectionId=:connectionId"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
